VITE_API_BASE_URL=https://lionfish-app-z6rt7.ondigitalocean.app
# Dev only: requests are proxied through the Vite dev server (see
# vite.config.js) by default, to work around the backend's CORS allowlist not
# including localhost. Once the backend allowlists your dev origin, set this
# to false to have dev call VITE_API_BASE_URL directly instead.
# VITE_USE_DEV_PROXY=false
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Add http://localhost:5173 and the production origin
# under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
VITE_USE_DEV_PROXY=
